{
  "name": "web-app-framework",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "vocabulary:generate": "pnpm --filter @app/vocabulary generate",
    "vocabulary:check": "pnpm --filter @app/vocabulary check",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "translate": "pnpm --filter @app/translator translate",
    "check": "pnpm vocabulary:check && pnpm lint && pnpm typecheck && pnpm test && pnpm translate:check && pnpm sql:ledger:check && pnpm flow:check",
    "translate:check": "pnpm --filter @app/translator translate --check",
    "database:up": "docker compose up -d --wait test-database",
    "database:down": "docker compose down",
    "test:database": "pnpm database:up && pnpm --filter @app/backend test:database",
    "sql:ledger": "pnpm --filter @app/translator sql:ledger",
    "sql:ledger:check": "pnpm --filter @app/translator sql:ledger --check",
    "dev:api": "pnpm --filter @app/server dev",
    "dev:web": "pnpm --filter @app/web dev",
    "vocabulary:find": "pnpm --silent --filter @app/vocabulary run find",
    "model": "pnpm --filter @app/translator model",
    "flow:check": "pnpm --filter @app/translator model --check",
    "dev:browser": "pnpm --filter @app/browser dev"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "jiti": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
